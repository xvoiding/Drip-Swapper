                        </StackPanel>
                      </Expander>
                    </StackPanel>
                    <Border Name="MkBuildsNote" Visibility="Collapsed" Margin="0,20,0,0" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                      <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Text}" Text="This paints the see-through blueprint you get while placing builds. When you use it you pick wood, brick or metal. It only shows while you build in a match or Creative, where Fortnite checks game files and online play can kick you for edited files. Undo it when you're done." />
                    </Border>
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer Name="MkBuildsRight" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
