              </StackPanel>
              <TextBlock Name="ModsEmpty" Grid.Row="1" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,80,0,0" Text="No drips yet.&#xA;Drop a file here, or press Import." />
            </Grid>
            <ScrollViewer Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,16">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Safety" Style="{StaticResource H2}" />
                    <CheckBox Name="AutoRevertBox" Content="Put the game files back automatically when Fortnite closes (recommended)" Margin="0,12,0,0" Checked="AutoRevert_Changed" Unchecked="AutoRevert_Changed" />
                    <CheckBox Name="ExperimentalBox" Margin="0,12,0,0" Content="Show experimental swap categories (contrails, lobby music, loading screens, toys, sprays, wraps, emoticons)" ToolTip="Nobody has confirmed these in game. Fortnite checks that a swapped item is built the same way as the original and can crash on launch when it isn't." Checked="Experimental_Changed" Unchecked="Experimental_Changed" />
                    <Button Name="RevertAllBtn" Content="Revert all swaps" MinWidth="150" Margin="0,14,0,0" HorizontalAlignment="Left" Click="RevertAll_Click" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Game folder" Style="{StaticResource H2}" />
                    <TextBlock Text="FortniteGame\Content\Paks. The app finds it by itself; only change it if it picked the wrong one." Style="{StaticResource Muted}" Margin="0,4,0,10" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Name="PathBox" />
                      <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="Browse_Click" />
                      <Button Name="ConnectBtn" Grid.Column="2" Content="Connect" Margin="8,0,0,0" Style="{StaticResource Primary}" Click="Connect_Click" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Backup paks" Style="{StaticResource H2}" />
                    <TextBlock Name="BackupInfo" Text="After every swap the app keeps a copy of the original pak (the container's untouched table of contents and its original data size) in its own folder, so you always have the game's real files to go back to." Style="{StaticResource Muted}" HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="620" Margin="0,4,0,12" />
                    <Button Content="Open backup pak folder" MinWidth="170" HorizontalAlignment="Left" Click="OpenBackupFolder_Click" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Something not working?" Style="{StaticResource H2}" />
                    <TextBlock Text="Try Fix problems first: it re-reads your game files and checks your swaps. If it still doesn't work, save a diagnostics file (one small zip in Downloads with the activity log; no keys, no game files) and send it to me." Style="{StaticResource Muted}" HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="620" Margin="0,4,0,12" />
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Fix problems" Style="{StaticResource Primary}" Click="FixProblems_Click" />
                      <Button Content="Save a diagnostics file" Margin="10,0,0,0" Click="Diagnostics_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Expander Header="More tools" Margin="4,20,0,0">
                  <WrapPanel Margin="0,10,0,0">
                    <Button Name="RescanEmotesBtn" Content="Re-check which emotes work" Margin="0,0,10,10" ToolTip="Dims emotes whose animation isn't downloaded on this PC (a swap to them would do nothing). Runs by itself when you open the Emotes tab." Click="RescanEmotes_Click" />
                  </WrapPanel>
                </Expander>
                <Expander Header="Activity log" Margin="4,12,0,0" IsExpanded="True">
                  <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12" Height="260">
                    <TextBox Name="LogBox" Style="{StaticResource Bare}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" />
                  </Border>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Border Name="SafetyBanner" Grid.Row="3" Padding="40,10" CornerRadius="0,0,19,19" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource External}">
            <TextBlock Name="SafetyText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text2}" Text="Lobby and Locker only. Swaps change what you see; online matches check game files and will kick modified ones." />
          </Border>
        </Grid>
        <Grid Name="NoticeOverlay" ZIndex="10" Visibility="Collapsed" Background="#99101010" MouseLeftButtonDown="NoticeBackdrop_Click">
          <Border MaxWidth="460" Margin="32" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource HeroLine}" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="Swallow_Click">
            <UIElement.Effect>
              <fx:DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.28" />
            </UIElement.Effect>
