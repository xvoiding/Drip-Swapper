                    <CheckBox Name="MkOutlineBox" Content="Show the character's blue outline" IsChecked="True" Margin="2,10,0,0" ToolTip="The blue line is the character in a T-pose. Line your model up with it: same size, feet on the ground, arms along the line, facing the front." Click="MkOutline_Click" />
