<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Drip.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fx="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore" xmlns:local="clr-namespace:Drip.App" Title="Drip Swapper" Icon="Assets/drip.ico" Width="1180" Height="740" AllowDrop="True" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="CanResize" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" Drop="Window_Drop" PreviewDragOver="Window_DragOver" PreviewKeyDown="Window_PreviewKeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="Tile" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="132" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource External}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource PanelHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <DataTemplate x:Key="GridIcon">
        <Border Style="{StaticResource Tile}" ToolTip="{Binding Tip}" Opacity="{Binding Dim}" MouseLeftButtonUp="GridIcon_Click" MouseRightButtonUp="Fav_RightClick">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Image Margin="0,10,0,0" IsHitTestVisible="False" Style="{StaticResource CosmeticIcon}" Source="{Binding Icon}" />
            <TextBlock Grid.Row="1" FontSize="11.5" Foreground="{DynamicResource Text}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,6,8,0" IsHitTestVisible="False" Text="{Binding Name}" />
            <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0" IsHitTestVisible="False" Fill="{Binding ReadyBrush}" />
            <TextBlock Text="★" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,6,0,0" IsHitTestVisible="False" Visibility="{Binding FavVisible}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="OptionIcon">
        <Border Style="{StaticResource Tile}" ToolTip="{Binding Tip}" Opacity="{Binding Dim}" MouseLeftButtonUp="OptionIcon_Click" MouseRightButtonUp="Fav_RightClick">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Image Margin="0,10,0,0" IsHitTestVisible="False" Style="{StaticResource CosmeticIcon}" Source="{Binding Icon}" />
            <TextBlock Grid.Row="1" FontSize="11.5" Foreground="{DynamicResource Text}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,6,8,0" IsHitTestVisible="False" Text="{Binding Name}" />
            <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0" IsHitTestVisible="False" Fill="{Binding ReadyBrush}" />
            <TextBlock Text="★" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,6,0,0" IsHitTestVisible="False" Visibility="{Binding FavVisible}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="StyleItem">
        <Border Width="120" Height="142" Style="{StaticResource Tile}" ToolTip="{Binding Name}" MouseLeftButtonUp="StyleItem_Click">
          <StackPanel>
            <Image Width="84" Height="84" Margin="0,10,0,0" IsHitTestVisible="False" Source="{Binding Icon}" />
            <TextBlock FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" Margin="6,6,6,0" IsHitTestVisible="False" Text="{Binding Name}" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <ItemsPanelTemplate x:Key="WrapItems">
        <WrapPanel />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="SwappedRow">
        <Border Margin="0,0,0,10" Padding="16,12" Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="56" Height="56" Source="{Binding SourceIcon}" ToolTip="{Binding SourceName}" />
            <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" Margin="12,0">
              <Path Fill="{DynamicResource OnAccent}" Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IcoArrow}" />
            </Border>
            <Image Grid.Column="2" Width="56" Height="56" Source="{Binding TargetIcon}" ToolTip="{Binding TargetName}" />
            <StackPanel Grid.Column="3" Margin="18,0,12,0" VerticalAlignment="Center">
              <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource H2}" Text="{Binding Title}" />
              <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
              <TextBlock FontSize="11.5" Foreground="{DynamicResource Warn}" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Text="{Binding NotesText}" Visibility="{Binding NotesVisible}" ToolTip="{Binding NotesText}" />
            </StackPanel>
            <TextBlock Grid.Column="4" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
            <Button Grid.Column="5" Content="Undo" MinWidth="80" VerticalAlignment="Center" Click="SwappedRevert_Click" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="PakSkinTile">
        <StackPanel Width="96" Margin="0,0,6,10" Cursor="Hand" Background="#00FFFFFF" ToolTip="{Binding Tip}" MouseLeftButtonUp="PakSkin_Click">
          <Grid Width="84" Height="84">
            <Image Stretch="Uniform" Source="{Binding Icon}" Visibility="{Binding IconVisible}" />
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Visibility="{Binding LetterVisible}">
              <TextBlock FontSize="28" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Display}" Text="{Binding Letter}" />
            </Border>
          </Grid>
          <TextBlock FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,6,2,0" Text="{Binding Name}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="PakCard">
        <Border Margin="0,0,0,12" Padding="18,14,18,6" Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <StackPanel Margin="0,0,90,0">
                <TextBlock FontSize="16" TextTrimming="CharacterEllipsis" Style="{StaticResource H2}" Text="{Binding Name}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Muted}" Text="{Binding Sub}" />
              </StackPanel>
              <Button Content="Remove" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Quiet}" Click="PakRemove_Click" />
            </Grid>
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14" Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
            <ItemsControl ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource PakSkinTile}" ItemsSource="{Binding Skins}" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="ModRow">
        <Border Margin="0,0,0,10" Padding="14" Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="60" Height="60" Margin="0,0,16,0" VerticalAlignment="Top" Background="{DynamicResource Panel}" CornerRadius="10" ClipToBounds="True">
              <Grid>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{DynamicResource Text2}" FontFamily="{StaticResource Display}" Text="{Binding Letter}" Visibility="{Binding LetterVisible}" />
                <Image Stretch="UniformToFill" Source="{Binding Icon}" Visibility="{Binding IconVisible}" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource H2}" Text="{Binding Name}" />
              <TextBlock Margin="0,2,0,0" Style="{StaticResource Muted}" Text="{Binding Sub}" />
              <TextBlock FontSize="12" LineHeight="18" Margin="0,6,0,0" Style="{StaticResource Body}" Text="{Binding Description}" />
              <TextBlock FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Detail}" />
              <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Status}" Visibility="{Binding StatusVisible}" Foreground="{Binding StatusBrush}" />
            </StackPanel>
            <Button Grid.Column="2" MinWidth="96" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Primary}" Content="{Binding UseText}" IsEnabled="{Binding CanUse}" Click="ModUse_Click" />
            <Button Grid.Column="3" Content="Remove" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource Quiet}" Click="ModRemove_Click" />
          </Grid>
        </Border>
      </DataTemplate>
      <Style x:Key="NavTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource H1}">
        <Setter Property="FontSize" Value="24" />
      </Style>
      <Style x:Key="StatLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="StatValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,3,0,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="{DynamicResource WindowBg}" CornerRadius="14" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Border Background="{DynamicResource Glow}" CornerRadius="14" IsHitTestVisible="False" />
      <Grid>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Row="0" Background="#00FFFFFF" Margin="28,14,14,0" MouseLeftButtonDown="TopBar_MouseDown">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Source="{StaticResource LogoMark}" Width="20" Height="20" ToolTip="Drip Swapper" />
              <TextBlock Text="Drip Swapper" FontFamily="{StaticResource Display}" FontSize="22" Foreground="{DynamicResource TextBright}" Margin="10,0,16,2" VerticalAlignment="Center" />
              <Button Name="GameChipBtn" Style="{StaticResource GameChip}" Content="Fortnite" ToolTip="Switch game" Click="SwitchGame_Click" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource TabCapsule}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
              <StackPanel Orientation="Horizontal">
                <RadioButton Name="TabHome" Style="{StaticResource NavTab}" Content="Home" Tag="Home" Click="Tab_Click" />
                <RadioButton Name="TabOutfits" Style="{StaticResource NavTab}" Content="Skins" Tag="Outfits" Click="Tab_Click" />
                <RadioButton Name="TabSwapped" Style="{StaticResource NavTab}" Content="Swapped" Tag="Swapped" Click="Tab_Click" />
                <RadioButton Name="TabMods" Style="{StaticResource NavTab}" Content="Add-ons" Tag="Mods" Click="Tab_Click" />
                <RadioButton Name="TabFun" Style="{StaticResource NavTab}" Content="Loadouts" Tag="Fun" Click="Tab_Click" />
                <RadioButton Name="TabSettings" Style="{StaticResource NavTab}" Content="Settings" Tag="Settings" Click="Tab_Click" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Discord" Style="{StaticResource Quiet}" ToolTip="Join our Discord: help, new drips and updates" Click="Discord_Click" />
              <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoContrast}" ToolTip="Switch between light and dark" Click="Theme_Click" />
              <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoMin}" Click="Minimize_Click" />
              <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoClose}" Click="Close_Click" />
            </StackPanel>
            <ProgressBar Name="BusyBar" Grid.ColumnSpan="3" IsIndeterminate="True" Visibility="Hidden" VerticalAlignment="Bottom" Margin="-28,0,-14,-6" />
          </Grid>
          <Grid Row="1" Background="#00FFFFFF" Margin="40,22,40,0" MouseLeftButtonDown="TopBar_MouseDown">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,16,0">
              <TextBlock Name="PageTitle" Text="Home" Style="{StaticResource H1}" />
              <TextBlock Name="PageSub" Style="{StaticResource Muted}" FontSize="14" Margin="2,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid Name="SearchWrap" Column="1" Width="260" Height="38" VerticalAlignment="Bottom" Visibility="Collapsed">
              <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="19" />
              <TextBox Name="SearchBox" Style="{StaticResource Field}" Padding="16,0,38,0" Height="38" BorderThickness="0" TextChanged="Search_Changed" />
              <TextBlock Name="SearchHint" Text="Search" Foreground="{DynamicResource Text2}" FontSize="13" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Path Data="{StaticResource IcoSearch}" Fill="{DynamicResource Text2}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,16,0" IsHitTestVisible="False" />
            </Grid>
          </Grid>
          <Grid Row="2" Margin="40,14,40,14">
            <ScrollViewer Name="HomePage" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,0">
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Style="{StaticResource Slot}" MinHeight="230" Margin="0,0,8,0" Click="Start_Click">
                    <Grid>
                      <TextBlock Text="You have" Foreground="{DynamicResource SlotText2}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" />
                      <StackPanel VerticalAlignment="Bottom">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SlotChip}" HorizontalAlignment="Left">
                          <Path Data="{StaticResource IcoPlus}" Fill="{DynamicResource SlotText}" Width="20" Height="20" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Pick the skin you have" FontFamily="{StaticResource Display}" FontSize="30" Foreground="{DynamicResource SlotText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="The outfit, pickaxe or back bling in your Locker right now." Foreground="{DynamicResource SlotText2}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="0,4,0,0" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Border Grid.Column="1" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Accent}" Margin="-14,0" Panel.ZIndex="2" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IcoSwap}" Fill="{DynamicResource OnAccent}" Width="22" Height="22" Stretch="Uniform" />
                  </Border>
                  <Button Grid.Column="2" Style="{StaticResource Slot}" MinHeight="230" Margin="8,0,0,0" Click="Start_Click">
                    <Grid>
                      <TextBlock Text="You want" Foreground="{DynamicResource SlotText2}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" />
                      <StackPanel VerticalAlignment="Bottom">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SlotChip}" HorizontalAlignment="Left">
                          <Path Data="{StaticResource IcoPlus}" Fill="{DynamicResource SlotText}" Width="20" Height="20" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Pick the skin you want" FontFamily="{StaticResource Display}" FontSize="30" Foreground="{DynamicResource SlotText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="Any other skin. Only you see it, in your lobby and Locker." Foreground="{DynamicResource SlotText2}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="0,4,0,0" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                  <Button Name="StartBtn" Content="Start swapping" MinWidth="200" Style="{StaticResource Go}" Click="Start_Click" />
                  <Button Content="Undo everything" MinWidth="160" Height="52" Margin="10,0,0,0" ToolTip="Puts all your original game files back" Click="RevertAll_Click" />
                  <Button Content="Fix problems" MinWidth="140" Height="52" Margin="10,0,0,0" ToolTip="Swap shows an error, or nothing changes? This re-reads your game files and checks which swaps are still in place." Click="FixProblems_Click" />
                </StackPanel>
                <TextBlock Name="ConnectMsg" Style="{StaticResource Muted}" Margin="2,10,0,0" Text="Starting up..." />
                <Border Style="{StaticResource WarnStrip}" Margin="0,18,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IcoWarn}" Fill="{DynamicResource Warn}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,12,0" />
                    <TextBlock Style="{StaticResource Body}" FontSize="12" LineHeight="18" MaxWidth="600" Text="Don't play online matches while a swap is on, Fortnite can kick you. Close Fortnite and your files go back to normal by themselves." />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="How it works" Style="{StaticResource H2}" />
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,0,12,10">
                        <TextBlock Text="1" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,3,0,10" Text="Close Fortnite and the Epic Games Launcher. Swaps can only be made while the game is closed." />
                      <Border Grid.Row="1" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,0,12,10">
                        <TextBlock Text="2" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,3,0,10" Text="Press Start swapping. Pick the skin you have, then the one you want, then press Swap." />
                      <Border Grid.Row="2" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,0,12,0">
                        <TextBlock Text="3" Foreground="{DynamicResource OnAccent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,3,0,0" Text="Open Fortnite and look in your lobby or Locker. Closing Fortnite puts your files back by itself." />
                    </Grid>
                    <StackPanel Margin="0,14,0,0">
                      <TextBlock Name="StepFound" Style="{StaticResource Muted}" />
                      <TextBlock Name="StepConnected" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                      <TextBlock Name="StepClosed" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Expander Header="Details" Margin="4,12,0,6">
                  <StackPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,16,0,6">
                      <StackPanel>
                        <UniformGrid Columns="4">
                          <StackPanel>
                            <TextBlock Text="Status" Style="{StaticResource StatLabel}" />
                            <TextBlock Name="StatStatus" Text="Not connected" Style="{StaticResource StatValue}" />
                          </StackPanel>
                          <StackPanel>
                            <TextBlock Text="Build" Style="{StaticResource StatLabel}" />
                            <TextBlock Name="StatBuild" Text="-" Style="{StaticResource StatValue}" />
                          </StackPanel>
                          <StackPanel>
                            <TextBlock Text="Containers" Style="{StaticResource StatLabel}" />
                            <TextBlock Name="StatContainers" Text="-" Style="{StaticResource StatValue}" />
                          </StackPanel>
                          <StackPanel>
                            <TextBlock Text="Active swaps" Style="{StaticResource StatLabel}" />
                            <TextBlock Name="StatSwaps" Text="0" Style="{StaticResource StatValue}" />
                          </StackPanel>
                        </UniformGrid>
                        <TextBlock Name="BannerSub" Text="Lobby and Locker only." Style="{StaticResource Muted}" Margin="0,10,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
            <Grid Name="OutfitsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                <RadioButton Name="CatOutfit" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Outfits" Tag="Outfit" IsChecked="True" Click="Cat_Click" />
                <RadioButton Name="CatPickaxe" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Pickaxes" Tag="Pickaxe" Click="Cat_Click" />
                <RadioButton Name="CatBackpack" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Back Blings" Tag="Backpack" Click="Cat_Click" />
                <RadioButton Name="CatEmote" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Emotes" Tag="Emote" Click="Cat_Click" />
                <RadioButton Name="CatGlider" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Gliders" Tag="Glider" Click="Cat_Click" />
                <RadioButton Name="CatContrail" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Contrails" Tag="Contrail" Click="Cat_Click" />
                <RadioButton Name="CatMusic" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Lobby Music" Tag="Music" ToolTip="Swap the music that plays in your lobby" Click="Cat_Click" />
                <RadioButton Name="CatLoading" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Loading Screens" Tag="Loading" Click="Cat_Click" />
                <RadioButton Name="CatToy" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Toys" Tag="Toy" Click="Cat_Click" />
                <RadioButton Name="CatSpray" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Sprays" Tag="Spray" Click="Cat_Click" />
                <RadioButton Name="CatWrap" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Wraps" Tag="Wrap" Click="Cat_Click" />
                <RadioButton Name="CatEmoticon" GroupName="Cats" Margin="0,0,8,8" Style="{StaticResource Pill}" Content="Emoticons" Tag="Emoticon" Click="Cat_Click" />
                <CheckBox Name="FavOnlyBox" Content="★ Favorites" Margin="12,0,0,8" VerticalAlignment="Center" ToolTip="Right-click any item to star it" Checked="FavOnly_Changed" Unchecked="FavOnly_Changed" />
                <CheckBox Name="GridReadyOnly" Content="Downloaded only" Margin="12,0,0,8" VerticalAlignment="Center" ToolTip="Hide skins whose character parts aren't downloaded (they'd kick you out of a match)" Checked="GridReady_Changed" Unchecked="GridReady_Changed" />
                <ComboBox Name="SortBox" Width="150" Height="32" Margin="16,0,0,8" SelectedIndex="0" ToolTip="Most Loved: the skins people ask for most, then the rarest, then the rest newest first" SelectionChanged="Sort_Changed">
                  <ComboBoxItem Content="Most Loved" />
                  <ComboBoxItem Content="Newest first" />
                  <ComboBoxItem Content="A to Z" />
                </ComboBox>
                <ComboBox Name="RarityBox" Width="150" Height="32" Margin="8,0,0,8" SelectedIndex="0" ToolTip="Show one rarity only" SelectionChanged="Sort_Changed" />
              </WrapPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="GridHost" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource GridIcon}" />
              </ScrollViewer>
              <TextBlock Name="EmptyText" Grid.Row="1" Text="Fortnite isn't connected yet. Go to Start here and wait for the green check." Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Name="CountText" Grid.Row="2" Style="{StaticResource Muted}" Margin="0,8,0,0" />
            </Grid>
            <Grid Name="FunPage" Visibility="Collapsed">
              <local:FunPanel x:Name="FunCtl" />
            </Grid>
            <Grid Name="SwappedPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
