                <StackPanel Margin="0,0,44,0">
                  <TextBlock Name="StyleTitle" Text="Which style?" Style="{StaticResource H1}" FontSize="26" />
                  <TextBlock Name="StyleSub" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseOverlays_Click" />
              </Grid>
              <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="StyleHost" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource StyleItem}" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="MakeOverlay" ZIndex="9" Visibility="Collapsed" Background="#99101010">
          <Border MaxWidth="1060" Margin="28,22" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource HeroLine}" BorderThickness="1" CornerRadius="18">
            <UIElement.Effect>
              <fx:DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.28" />
            </UIElement.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="28,22,18,0">
                <StackPanel>
                  <TextBlock Text="Make a model" Style="{StaticResource H1}" FontSize="26" />
                  <TextBlock Name="MkMakeSub" Style="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Turn a 3D model into a drip. The whole model replaces your Rebirth Soldier's body in the lobby, not just a coat of paint." />
                </StackPanel>
                <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseMake_Click" />
              </Grid>
              <Grid Row="1" Margin="28,16,28,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="320" />
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="WHAT ARE YOU MAKING?" Style="{StaticResource Overline}" />
                    <WrapPanel Margin="0,8,0,16">
                      <RadioButton Name="MkKindModel" GroupName="MkKind" Style="{StaticResource Pill}" Content="Character model" IsChecked="True" ToolTip="A 3D model that replaces your Rebirth Soldier in the lobby" Click="MkKind_Click" />
                      <RadioButton Name="MkKindBuilds" GroupName="MkKind" Style="{StaticResource Pill}" Content="Builds" ToolTip="A look for the see-through blueprint you get while placing builds (wood, brick or metal is picked when you apply it)" Click="MkKind_Click" />
                      <RadioButton Name="MkKindPickaxe" GroupName="MkKind" Style="{StaticResource Pill}" Content="Pickaxe" ToolTip="A 3D model of a pickaxe, lined up against a plain pickaxe outline" Click="MkKind_Click" />
                      <RadioButton Name="MkKindBackBling" GroupName="MkKind" Style="{StaticResource Pill}" Content="Back bling" ToolTip="A 3D model of a back bling, lined up against a bag outline on the character's back" Click="MkKind_Click" />
                    </WrapPanel>
                    <StackPanel Name="MkModelTop">
                      <TextBlock Text="1 · YOUR MODEL" Style="{StaticResource Overline}" />
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Name="MkFileBox" IsReadOnly="True" ToolTip="The model (FBX, OBJ, GLB, glTF, DAE, 3DS... or a .zip with one inside)" />
                        <Button Grid.Column="1" Content="Choose…" Margin="8,0,0,0" Style="{StaticResource Primary}" Click="MkChooseModel_Click" />
                      </Grid>
                      <TextBlock Text="FBX, OBJ, GLB and more, or a .zip with the model and its pictures inside. You can also drop a file on this window." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,6,0,0" />
                      <TextBlock Text="2 · PICTURE (OPTIONAL)" Style="{StaticResource Overline}" Margin="0,20,0,0" />
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Name="MkPicBox" IsReadOnly="True" ToolTip="One picture to put on the whole model. Leave empty to use the model's own pictures." />
                        <Button Grid.Column="1" Content="Choose…" Margin="8,0,0,0" Click="MkChoosePicture_Click" />
                        <Button Grid.Column="2" Content="Clear" Margin="6,0,0,0" Style="{StaticResource Quiet}" Click="MkClearPicture_Click" />
                      </Grid>
                      <TextBlock Name="MkPicNote" Text="Left empty, the model's own pictures and colours are used." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,6,0,0" />
                    </StackPanel>
                    <StackPanel Name="MkBuildsTop" Visibility="Collapsed">
                      <TextBlock Text="1 · LOOK" Style="{StaticResource Overline}" />
                      <ComboBox Name="MkBLook" Margin="0,8,0,0" ToolTip="A ready-made look, or your own picture" SelectionChanged="MkBLook_Changed" />
                      <Grid Name="MkBPickRow" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Name="MkBPicBox" IsReadOnly="True" ToolTip="The picture that goes on your builds (PNG, JPG, BMP or TGA)" />
                        <Button Grid.Column="1" Content="Choose…" Margin="8,0,0,0" Style="{StaticResource Primary}" Click="MkBChoosePicture_Click" />
                      </Grid>
                      <TextBlock Name="MkBLookNote" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,6,0,0" />
                    </StackPanel>
                    <TextBlock Name="MkNameLabel" Text="3 · NAME" Style="{StaticResource Overline}" Margin="0,20,0,0" />
                    <TextBox Name="MkNameBox" Margin="0,8,0,0" MaxLength="60" ToolTip="What it's called in your Add-ons list" TextChanged="MkName_Changed" />
                    <StackPanel Name="MkModelBottom">
                      <Border Name="MkItemNote" Visibility="Collapsed" Margin="0,20,0,0" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <TextBlock Name="MkItemNoteText" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Text}" />
                      </Border>
                      <Border Name="MkCharNote" Margin="0,20,0,0" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource Text}" Text="The model's own shape is attached to the character's skeleton, so it moves with the lobby pose. Emotes and some animations can look a bit off, and the face doesn't animate. Lobby and Locker only, like every swap." />
                      </Border>
                      <Expander Header="More options" Margin="0,16,0,0">
                        <StackPanel Margin="0,8,0,0">
                          <TextBlock Text="Which way is up in the file?" Style="{StaticResource Muted}" Margin="2,0,0,4" />
                          <ComboBox Name="MkUpBox" SelectedIndex="0" SelectionChanged="MkFit_Changed">
                            <ComboBoxItem Content="Work it out for me" />
                            <ComboBoxItem Content="Y is up (most files)" />
                            <ComboBoxItem Content="Z is up (Blender, 3ds Max)" />
                            <ComboBoxItem Content="Upside down" />
                          </ComboBox>
