                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Front" Height="28" MinWidth="52" Padding="10,0" FontSize="12" Tag="0" Click="MkView_Click" />
                        <Button Content="Side" Height="28" MinWidth="52" Padding="10,0" Margin="6,0,0,0" FontSize="12" Tag="90" Click="MkView_Click" />
                        <Button Content="Back" Height="28" MinWidth="52" Padding="10,0" Margin="6,0,0,0" FontSize="12" Tag="180" Click="MkView_Click" />
                        <Button Content="3/4" Height="28" MinWidth="52" Padding="10,0" Margin="6,0,0,0" FontSize="12" Tag="35" Click="MkView_Click" />
                      </StackPanel>
