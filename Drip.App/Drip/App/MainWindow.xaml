                      <RadioButton GroupName="MkPiece" Style="{StaticResource Pill}" Content="Floor" Tag="floor" Click="MkPiece_Click" />
                      <RadioButton GroupName="MkPiece" Style="{StaticResource Pill}" Content="Stairs" Tag="stairs" Click="MkPiece_Click" />
                      <RadioButton GroupName="MkPiece" Style="{StaticResource Pill}" Content="Roof" Tag="roof" Click="MkPiece_Click" />
                    </StackPanel>
                    <CheckBox Name="MkBOutline" Content="Show the normal build's blue outline" IsChecked="True" Margin="2,10,0,0" ToolTip="The blue line is a plain drawing of the normal build piece, so you can see your look sitting inside it" Click="MkPiece_Click" />
                    <TextBlock Name="MkBInfo" Style="{StaticResource Muted}" Margin="2,8,0,0" TextWrapping="Wrap" Text="Blue outline = the normal build (a simple drawing of the piece). Your look fills it in. The game repeats the picture over the blueprint, so this shows roughly how it tiles." />
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer Name="MkModelRight" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="4 · LINE IT UP" Style="{StaticResource Overline}" />
                    <Border Margin="0,8,0,0" CornerRadius="12" Background="#1A1A1D" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True" Height="360">
                      <Grid>
                        <Image Name="MkPreview" Stretch="Uniform" Cursor="SizeWE" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="MkPreview_Down" MouseMove="MkPreview_Move" MouseLeftButtonUp="MkPreview_Up" />
                        <TextBlock Name="MkEmpty" Text="Step 1: choose a 3D model (.fbx, .glb, .obj or a zip)&#xA;Step 2: line it up with the blue character&#xA;Step 3: press Create drip" TextAlignment="Center" Foreground="{DynamicResource Text2}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Border Name="MkBusy" Visibility="Collapsed" Background="#99101013">
                          <TextBlock Name="MkBusyText" Text="Working…" Foreground="{DynamicResource TextBright}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
