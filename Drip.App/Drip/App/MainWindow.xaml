                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Size" Style="{StaticResource Muted}" VerticalAlignment="Center" />
