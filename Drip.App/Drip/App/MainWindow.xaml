                          <TextBlock Name="MkSizeText" Grid.Column="2" Text="1.00x" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Width" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="Stretches the model sideways. Use it to line the arms up if they come out too short or too long." />
                          <Slider Name="MkWidth" Grid.Column="1" Minimum="0.6" Maximum="1.6" Value="1" SmallChange="0.01" LargeChange="0.05" ValueChanged="MkSlider_Changed" />
                          <TextBlock Name="MkWidthText" Grid.Column="2" Text="1.00x" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Left / right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="MkMoveX" Grid.Column="1" Minimum="-30" Maximum="30" Value="0" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="MkSlider_Changed" />
                          <TextBlock Name="MkMoveXText" Grid.Column="2" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Forward / back" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="MkMoveY" Grid.Column="1" Minimum="-30" Maximum="30" Value="0" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="MkSlider_Changed" />
                          <TextBlock Name="MkMoveYText" Grid.Column="2" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Up / down" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="MkMoveZ" Grid.Column="1" Minimum="-30" Maximum="30" Value="0" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="MkSlider_Changed" />
                          <TextBlock Name="MkMoveZText" Grid.Column="2" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Button Content="Reset" MinWidth="80" Margin="0,10,0,0" HorizontalAlignment="Left" Click="MkReset_Click" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Rotation" IsExpanded="True" Margin="0,12,0,0">
                      <StackPanel Margin="0,10,0,0">
                        <Button Content="Auto-align" MinWidth="120" HorizontalAlignment="Left" Style="{StaticResource Primary}" ToolTip="Turns the model so its arms or shoulders run along the character's and it faces the front" Click="MkAutoAlign_Click" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                          <Button Content="Turn 90°" MinWidth="100" ToolTip="Spin the model a quarter turn" Click="MkTurn_Click" />
                          <Button Content="Flip front/back" MinWidth="130" Margin="8,0,0,0" ToolTip="Swap which side is the front" Click="MkFlip_Click" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Turn" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="MkYaw" Grid.Column="1" Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="MkSlider_Changed" />
                          <TextBlock Name="MkYawText" Grid.Column="2" Text="0°" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
              <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,14" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Name="MkStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
                  <Button Name="MkSaveBtn" Grid.Column="1" Content="Save a copy…" Style="{StaticResource Quiet}" Height="36" IsEnabled="False" ToolTip="Saves the .dripFN anywhere you like, to share it or keep it" Click="MkSaveCopy_Click" />
                  <Button Name="MkCreateBtn" Grid.Column="2" Content="Create drip" MinWidth="160" Margin="8,0,0,0" Style="{StaticResource Primary}" IsEnabled="False" Click="MkCreate_Click" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="SwapOverlay" ZIndex="9" Visibility="Collapsed" Background="#99101010">
          <Border MaxWidth="640" MaxHeight="620" Margin="32" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource HeroLine}" BorderThickness="1" CornerRadius="18">
            <UIElement.Effect>
              <fx:DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.28" />
            </UIElement.Effect>
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,40,28,24">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel>
                      <Border Width="150" Height="150" Background="{DynamicResource External}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                        <Image Name="SwapSrcImg" Margin="8" />
                      </Border>
                      <TextBlock Text="THE SKIN YOU HAVE" Style="{StaticResource Overline}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                      <Button Name="SrcStyleBtn" Tag="Src" Content="Style: Default" Height="28" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" Click="ChangeStyle_Click" />
                    </StackPanel>
                    <Path Data="{StaticResource IcoArrow}" Fill="{DynamicResource Accent}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" Margin="24,64,24,0" />
                    <StackPanel>
                      <Border Width="150" Height="150" Background="{DynamicResource External}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                        <Image Name="SwapTgtImg" Margin="8" />
                      </Border>
                      <TextBlock Text="YOU WILL LOOK LIKE" Style="{StaticResource Overline}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                      <Button Name="TgtStyleBtn" Tag="Tgt" Content="Style: Default" Height="28" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" Click="ChangeStyle_Click" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Name="SwapName" Text="" FontFamily="{StaticResource Display}" FontSize="20" Foreground="{DynamicResource TextBright}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Margin="0,18,0,0" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="Swap is  " FontSize="13" Foreground="{DynamicResource Text2}" />
                    <TextBlock Name="SwapStatus" Text="OFF" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Name="ReadyNote" Text="" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="500" Margin="0,10,0,0" Foreground="{DynamicResource Text2}" />
                  <TextBlock Name="LockerNote" Text="" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" HorizontalAlignment="Center" MaxWidth="500" Margin="0,8,0,0" Foreground="{DynamicResource Warn}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Name="SwapRevertBtn" Content="Undo" MinWidth="120" Height="46" Click="OverlayRevert_Click" />
                    <Button Name="SwapConvertBtn" Content="Apply swap" MinWidth="190" Height="46" Margin="10,0,0,0" Style="{StaticResource Go}" Click="Convert_Click" />
                  </StackPanel>
                  <TextBlock Name="SwapLog" Text="" FontSize="12" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="500" Margin="0,14,0,0" />
                </StackPanel>
              </ScrollViewer>
              <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Click="CloseOverlays_Click" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>