                <ItemsControl Name="OptHost" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource OptionIcon}" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="StyleOverlay" ZIndex="9" Visibility="Collapsed" Background="#99101010">
          <Border MaxWidth="660" MaxHeight="480" Margin="32" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource HeroLine}" BorderThickness="1" CornerRadius="18">
            <UIElement.Effect>
              <fx:DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.28" />
            </UIElement.Effect>
            <Grid Margin="28,24,28,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
