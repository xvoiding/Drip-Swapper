                      </ComboBox>
                      <TextBlock Text="Surface look" Style="{StaticResource Muted}" Margin="2,12,0,4" />
                      <ComboBox Name="MapMaterialBox" SelectedIndex="0" ToolTip="Which of the game's materials your picture goes on. If the map comes out wrong, try another one and swap again." SelectionChanged="MapMaterial_Changed">
                        <ComboBoxItem Content="Boost pad (shows your picture)" />
                        <ComboBoxItem Content="Labs panels (stock field look)" />
                        <ComboBoxItem Content="Labs trim" />
                        <ComboBoxItem Content="Goal net" />
                      </ComboBox>
                      <CheckBox Name="MapSceneryBox" Content="Keep the stock scenery outside the arena" Margin="0,12,0,0" ToolTip="Off (the default): the whole stock map is switched off and only your model shows. On: only the stock playfield is replaced and the scenery around it stays (hills, buildings, sky)." Click="MapScenery_Changed" />
                    </StackPanel>
                    <CheckBox Name="KeepWheelsBox" IsChecked="True" Margin="0,14,0,0" Content="Put Rocket League's wheels on this car" ToolTip="Turn this off if your model already has wheels built in (or you want none). When you swap the car in, the app offers to hide the game's wheels so they don't show on top of yours." />
                    <Expander Header="More options" Margin="0,16,0,0">
                      <StackPanel Margin="0,8,0,0">
                        <CheckBox Name="LeaveOutBox" Content="Leave out wheels and tires (the game puts its own on)" IsChecked="True" Click="Fit_Changed" />
                        <CheckBox Name="ColorsBox" Content="Paint it from the model's material colors (no texture pictures)" Margin="0,8,0,0" Click="Fit_Changed" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="4 · LINE IT UP" Style="{StaticResource Overline}" />
                    <Grid Margin="0,8,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border CornerRadius="12" Background="#1A1A1D" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True" ToolTip="Side view. Drag to move forward/back and up/down.">
                        <Image Name="PreviewA" Stretch="Uniform" Cursor="SizeAll" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="Preview_Down" MouseMove="Preview_Move" MouseLeftButtonUp="Preview_Up" />
                      </Border>
                      <Border Grid.Column="2" CornerRadius="12" Background="#1A1A1D" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True" ToolTip="Top view. Drag to move forward/back and left/right.">
                        <Image Name="PreviewB" Stretch="Uniform" Cursor="SizeAll" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="Preview_Down" MouseMove="Preview_Move" MouseLeftButtonUp="Preview_Up" />
                      </Border>
                      <Border Grid.Row="2" CornerRadius="12" Background="#1A1A1D" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True" ToolTip="Front view. Drag to move left/right and up/down.">
                        <Image Name="PreviewC" Stretch="Uniform" Cursor="SizeAll" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="Preview_Down" MouseMove="Preview_Move" MouseLeftButtonUp="Preview_Up" />
                      </Border>
                      <Border Grid.Row="2" Grid.Column="2" CornerRadius="12" Background="#1A1A1D" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                        <Image Name="PreviewD" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border>
                    </Grid>
                    <TextBlock Name="PreviewNote" Style="{StaticResource Muted}" Margin="2,8,0,0" Text="Blue outline = a real Octane. Yellow dashes = its middle. Pink cross = the middle of your model. Drag a picture to move the model, or use the sliders." />
                    <Expander Header="Size and position" IsExpanded="True" Margin="0,14,0,0">
                      <StackPanel Margin="0,10,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Size" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="SizeSlider" Grid.Column="1" Minimum="0.3" Maximum="2.5" Value="1" ValueChanged="Fit_Slider" />
                          <TextBlock Name="SizeText" Grid.Column="2" Text="1.0x" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Forward / back" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="MoveXSlider" Grid.Column="1" Minimum="-60" Maximum="60" Value="0" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Fit_Slider" />
                          <TextBlock Name="MoveXText" Grid.Column="2" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Left / right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="MoveYSlider" Grid.Column="1" Minimum="-40" Maximum="40" Value="0" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Fit_Slider" />
                          <TextBlock Name="MoveYText" Grid.Column="2" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Up / down" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="LiftSlider" Grid.Column="1" Minimum="-40" Maximum="40" Value="0" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Fit_Slider" />
                          <TextBlock Name="LiftText" Grid.Column="2" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Content="Center on Octane" MinWidth="150" Style="{StaticResource Primary}" ToolTip="Lines the middle of the model up with the middle of the Octane (front to back and side to side)" Click="CenterOnOctane_Click" />
                          <Button Content="Reset" MinWidth="80" Margin="8,0,0,0" Click="ResetMove_Click" />
                        </StackPanel>
                      </StackPanel>
                    </Expander>
                    <Expander Header="Rotation" Margin="0,12,0,0">
                      <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Turn 90°" MinWidth="100" ToolTip="Spin the model a quarter turn around" Click="Turn_Click" />
                          <Button Content="Flip front/back" MinWidth="130" Margin="8,0,0,0" ToolTip="Swap which end is the front" Click="Flip_Click" />
                          <TextBlock Name="TurnText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Turn left / right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="YawSlider" Grid.Column="1" Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Fit_Slider" />
                          <TextBlock Name="YawText" Grid.Column="2" Text="0°" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Nose up / down" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="PitchSlider" Grid.Column="1" Minimum="-90" Maximum="90" Value="0" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Fit_Slider" />
                          <TextBlock Name="PitchText" Grid.Column="2" Text="0°" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Lean left / right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                          <Slider Name="RollSlider" Grid.Column="1" Minimum="-90" Maximum="90" Value="0" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Fit_Slider" />
                          <TextBlock Name="RollText" Grid.Column="2" Text="0°" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextBright}" />
                        </Grid>
                        <Button Content="Reset rotation" MinWidth="130" Margin="0,10,0,0" HorizontalAlignment="Left" Click="ResetRotation_Click" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
              <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,14" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Name="ModStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <Button Grid.Column="1" Content="Clear pictures" Style="{StaticResource Quiet}" Height="36" Click="ClearPictures_Click" />
                  <Button Name="CreateBtn" Grid.Column="2" Content="Create model" MinWidth="160" Margin="8,0,0,0" Style="{StaticResource Primary}" IsEnabled="False" Click="CreateModel_Click" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="PickOverlay" ZIndex="11" Visibility="Collapsed" Background="#99101010" MouseLeftButtonDown="Backdrop_Click">
          <Border MaxWidth="920" MaxHeight="660" Margin="32" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource HeroLine}" BorderThickness="1" CornerRadius="18" MouseLeftButtonDown="Swallow_Click">
            <UIElement.Effect>
              <fx:DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.28" />
            </UIElement.Effect>
            <Grid Margin="28,24,28,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <StackPanel Margin="0,0,44,0">
                  <TextBlock Name="PickTitle" Style="{StaticResource H1}" FontSize="26" TextTrimming="CharacterEllipsis" />
                  <TextBlock Name="PickSub" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseOverlays_Click" />
              </Grid>
              <Grid Row="1" Height="38" Margin="0,16,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" />
                <TextBox Name="PickSearch" Style="{StaticResource Field}" Height="38" Padding="14,0" BorderThickness="0" TextChanged="PickSearch_Changed" />
                <Button Name="SurpriseBtn" Grid.Column="1" Content="Surprise me" Margin="12,0,0,0" Padding="16,0" ToolTip="Picks a random look for you" Click="Surprise_Click" />
              </Grid>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="PickHost" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource DonorTile}" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>