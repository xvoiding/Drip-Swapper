                        <ComboBoxItem Content="Let the game paint it (picture on the paintable body)" />
                        <ComboBoxItem Content="Let the game paint it (picture only)" />
                        <ComboBoxItem Content="Shape only (the game's own paint)" />
                        <ComboBoxItem Content="Paint on top of my picture" />
                      </ComboBox>
