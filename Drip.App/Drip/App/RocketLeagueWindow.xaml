<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Drip.App.RocketLeagueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fx="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore" xmlns:local="clr-namespace:Drip.App" Title="Drip Swapper" Icon="Assets/drip.ico" Width="1180" Height="760" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="CanResize" AllowDrop="True" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" Drop="Window_Drop" PreviewDragOver="Window_DragOver" PreviewKeyDown="Window_PreviewKeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="HomeTile" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="14" />
        <Setter Property="Border.Padding" Value="16,14" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource PanelHover}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Tile" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="144" />
        <Setter Property="Height" Value="172" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Border.CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource External}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource PanelHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <ItemsPanelTemplate x:Key="WrapItems">
        <WrapPanel />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="ItemTile">
        <Border Style="{StaticResource Tile}" ToolTip="{Binding Tip}" MouseLeftButtonUp="ItemTile_Click" MouseRightButtonUp="Fav_RightClick">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="118" />
              <RowDefinition Height="*" />
              <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <Image Margin="12,12,12,0" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" />
            <TextBlock Text="★" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,6,0,0" IsHitTestVisible="False" Visibility="{Binding FavVisible}" />
            <TextBlock Grid.Row="1" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding Name}" />
            <Border Grid.Row="2" CornerRadius="0,0,13,13" Opacity="0.9" IsHitTestVisible="False" Background="{Binding QualityBrush}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="DonorTile">
        <Border Style="{StaticResource Tile}" ToolTip="{Binding Tip}" MouseLeftButtonUp="DonorTile_Click" MouseRightButtonUp="Fav_RightClick">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="118" />
              <RowDefinition Height="*" />
              <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <Image Margin="12,12,12,0" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" />
            <TextBlock Text="★" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,6,0,0" IsHitTestVisible="False" Visibility="{Binding FavVisible}" />
            <TextBlock Grid.Row="1" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding Name}" />
            <Border Grid.Row="2" CornerRadius="0,0,13,13" Opacity="0.9" IsHitTestVisible="False" Background="{Binding QualityBrush}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="ModelRow">
        <Border Margin="0,0,0,10" Padding="14,12" Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="60" Height="60" CornerRadius="10" Background="{DynamicResource InputBg}" ClipToBounds="True" VerticalAlignment="Center">
              <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
              <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource H2}" Text="{Binding Name}" />
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Border Style="{StaticResource Chip}">
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextBright}" Text="{Binding Kind}" />
                </Border>
                <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Text="{Binding Triangles}" />
                <TextBlock Text="  ·  Textured" FontSize="12" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Visibility="{Binding TexturedVisibility}" />
              </StackPanel>
              <Button HorizontalAlignment="Left" Margin="0,8,0,0" Cursor="Hand" ToolTip="On: Rocket League's wheels stay on this car. Off: the model brings its own wheels, so after you swap it in the app offers to hide the game's wheels. Click to switch." Visibility="{Binding WheelsVisibility}" Click="ModelWheels_Click">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="bd" Background="#00FFFFFF" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11" Padding="10,3">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding WheelsBrush}" />
                        <TextBlock FontSize="11.5" Margin="7,0,0,0" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Text="{Binding WheelsText}" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="bd" Value="{DynamicResource Edge}" Property="Border.BorderBrush" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Swap…" MinWidth="88" Style="{StaticResource Primary}" Click="ModelUse_Click" />
              <Button Content="Export" MinWidth="60" Margin="6,0,0,0" Height="36" Style="{StaticResource Quiet}" Click="ModelExport_Click" />
              <Button Content="Delete" MinWidth="60" Height="36" Style="{StaticResource Quiet}" Click="ModelDelete_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="SwapRow">
        <Border Margin="0,0,0,10" Padding="16,12" Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="56" Height="56" Opacity="0.6" Source="{Binding TargetIcon}" ToolTip="{Binding TargetName}" />
            <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" Margin="12,0">
              <Path Fill="{DynamicResource OnAccent}" Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IcoArrow}" />
            </Border>
            <Image Grid.Column="2" Width="56" Height="56" Source="{Binding DonorIcon}" ToolTip="{Binding DonorName}" />
            <StackPanel Grid.Column="3" Margin="18,0,12,0" VerticalAlignment="Center">
              <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource H2}" Text="{Binding Title}" />
              <TextBlock FontSize="12" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
            </StackPanel>
            <Button Grid.Column="4" Content="Revert" MinWidth="88" VerticalAlignment="Center" Click="SwapRevert_Click" />
          </Grid>
        </Border>
      </DataTemplate>
      <Style x:Key="StatLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="StatValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,3,0,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border CornerRadius="14" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Border Background="{DynamicResource Glow}" CornerRadius="14" IsHitTestVisible="False" />
      <Grid>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Row="0" Background="#00FFFFFF" Margin="28,14,14,0" MouseLeftButtonDown="TopBar_MouseDown">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Source="{StaticResource LogoMark}" Width="20" Height="20" ToolTip="Drip Swapper" />
              <TextBlock Text="Drip Swapper" FontFamily="{StaticResource Display}" FontSize="22" Foreground="{DynamicResource TextBright}" Margin="10,0,16,2" VerticalAlignment="Center" />
              <Button Style="{StaticResource GameChip}" Content="Rocket League" ToolTip="Switch game" Click="SwitchGame_Click" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource TabCapsule}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
              <StackPanel Orientation="Horizontal">
                <RadioButton Name="TabHome" Style="{StaticResource NavTab}" Content="Home" Tag="Home" Click="Tab_Click" />
                <RadioButton Name="TabItems" Style="{StaticResource NavTab}" Content="Swap" Tag="Items" Click="Tab_Click" />
                <RadioButton Name="TabMods" Style="{StaticResource NavTab}" Content="Models" Tag="Mods" Click="Tab_Click" />
                <RadioButton Name="TabSwaps" Style="{StaticResource NavTab}" Content="Swapped" Tag="Swaps" Click="Tab_Click" />
                <RadioButton Name="TabLive" Style="{StaticResource NavTab}" Content="Extras" Tag="Live" Click="Tab_Click" />
                <RadioButton Name="TabFun" Style="{StaticResource NavTab}" Content="Loadouts" Tag="Fun" Click="Tab_Click" />
                <RadioButton Name="TabSettings" Style="{StaticResource NavTab}" Content="Settings" Tag="Settings" Click="Tab_Click" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Discord" Style="{StaticResource Quiet}" ToolTip="Join our Discord: help, new drips and updates" Click="Discord_Click" />
              <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoContrast}" ToolTip="Switch between light and dark" Click="Theme_Click" />
              <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoMin}" Click="Minimize_Click" />
              <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoClose}" Click="Close_Click" />
            </StackPanel>
            <ProgressBar Name="BusyBar" Grid.ColumnSpan="3" IsIndeterminate="True" Visibility="Hidden" VerticalAlignment="Bottom" Margin="-28,0,-14,-6" />
          </Grid>
          <Grid Row="1" Background="#00FFFFFF" Margin="40,22,40,0" MouseLeftButtonDown="TopBar_MouseDown">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,16,0">
              <TextBlock Name="PageTitle" Text="Home" Style="{StaticResource H1}" />
              <TextBlock Name="PageSub" Style="{StaticResource Muted}" FontSize="14" Margin="2,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid Name="SearchWrap" Column="1" Width="260" Height="38" VerticalAlignment="Bottom" Visibility="Collapsed">
              <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="19" />
              <TextBox Name="SearchBox" Style="{StaticResource Field}" Padding="16,0,38,0" Height="38" BorderThickness="0" TextChanged="Search_Changed" />
              <TextBlock Name="SearchHint" Text="Search" Foreground="{DynamicResource Text2}" FontSize="13" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Path Data="{StaticResource IcoSearch}" Fill="{DynamicResource Text2}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,16,0" IsHitTestVisible="False" />
            </Grid>
          </Grid>
          <Grid Row="2" Margin="40,14,40,14">
            <ScrollViewer Name="HomePage" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,0">
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Style="{StaticResource Slot}" MinHeight="230" Margin="0,0,8,0" Click="Start_Click">
                    <Grid>
                      <TextBlock Text="You have" Foreground="{DynamicResource SlotText2}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" />
                      <StackPanel VerticalAlignment="Bottom">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SlotChip}" HorizontalAlignment="Left">
                          <Path Data="{StaticResource IcoPlus}" Fill="{DynamicResource SlotText}" Width="20" Height="20" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Pick what you use now" FontFamily="{StaticResource Display}" FontSize="30" Foreground="{DynamicResource SlotText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="The car, wheels, ball or other item you have equipped." Foreground="{DynamicResource SlotText2}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="0,4,0,0" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Border Grid.Column="1" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Accent}" Margin="-14,0" Panel.ZIndex="2" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Data="{StaticResource IcoSwap}" Fill="{DynamicResource OnAccent}" Width="22" Height="22" Stretch="Uniform" />
                  </Border>
                  <Button Grid.Column="2" Style="{StaticResource Slot}" MinHeight="230" Margin="8,0,0,0" Click="Start_Click">
                    <Grid>
                      <TextBlock Text="You want" Foreground="{DynamicResource SlotText2}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top" />
                      <StackPanel VerticalAlignment="Bottom">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SlotChip}" HorizontalAlignment="Left">
                          <Path Data="{StaticResource IcoPlus}" Fill="{DynamicResource SlotText}" Width="20" Height="20" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Pick what you want" FontFamily="{StaticResource Display}" FontSize="30" Foreground="{DynamicResource SlotText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <TextBlock Text="Any other car, wheels or ball. Or one of your own models." Foreground="{DynamicResource SlotText2}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="0,4,0,0" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                  <Button Name="StartBtn" Content="Start swapping" MinWidth="200" Style="{StaticResource Go}" Click="Start_Click" />
                  <Button Content="Undo everything" MinWidth="160" Height="52" Margin="10,0,0,0" ToolTip="Puts all your original game files back" Click="RevertAll_Click" />
                </StackPanel>
                <TextBlock Name="ConnectMsg" Style="{StaticResource Muted}" Margin="2,10,0,0" Text="Starting up..." />
                <Border Name="SetupCard" Style="{StaticResource Card}" Padding="20,6" Margin="0,20,0,0">
                  <StackPanel>
                    <Grid Margin="0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Name="SetupGameDot" Width="12" Height="12" Fill="{DynamicResource Danger}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="1  Find the game" Style="{StaticResource H2}" />
                        <TextBlock Name="SetupGameText" Style="{StaticResource Muted}" Margin="0,3,16,0" />
                      </StackPanel>
                      <Button Name="SetupGameBtn" Grid.Column="2" Content="Find game…" MinWidth="140" VerticalAlignment="Center" Click="SetupGame_Click" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="30" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Name="SetupKeysDot" Width="12" Height="12" Fill="{DynamicResource Danger}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="2  Add the keys file" Style="{StaticResource H2}" />
                          <TextBlock Name="SetupKeysText" Style="{StaticResource Muted}" Margin="0,3,16,0" />
                        </StackPanel>
                        <Button Name="SetupKeysBtn" Grid.Column="2" Content="Add keys file…" MinWidth="140" VerticalAlignment="Center" Click="SetupKeys_Click" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="30" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Name="SetupReadyDot" Width="12" Height="12" Fill="{DynamicResource Danger}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="3  You're ready" Style="{StaticResource H2}" />
                          <TextBlock Name="SetupReadyText" Style="{StaticResource Muted}" Margin="0,3,16,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
                <TextBlock Text="More to try" Style="{StaticResource H2}" Margin="2,28,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource HomeTile}" Tag="Items" MouseLeftButtonUp="HomeTile_Click">
                    <StackPanel>
                      <Path Data="{StaticResource IcoBox}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" />
                      <TextBlock Text="Swap an item" Style="{StaticResource H2}" Margin="0,10,0,0" />
                      <TextBlock Text="Make your car, wheels or ball look like another one." Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource HomeTile}" Tag="Mods" MouseLeftButtonUp="HomeTile_Click">
                    <StackPanel>
                      <Path Data="{StaticResource IcoCube}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentB}" HorizontalAlignment="Left" />
                      <TextBlock Text="Use my own model" Style="{StaticResource H2}" Margin="0,10,0,0" />
                      <TextBlock Text="Bring a 3D car, wheel, ball or map into the game." Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="4" Style="{StaticResource HomeTile}" Tag="Live" MouseLeftButtonUp="HomeTile_Click">
                    <StackPanel>
                      <Path Data="{StaticResource IcoBolt}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource Good}" HorizontalAlignment="Left" />
                      <TextBlock Text="In-game extras" Style="{StaticResource H2}" Margin="0,10,0,0" />
                      <TextBlock Text="Freeplay tweaks: boost, jumps, speed, match timer." Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,16,0,16">
                  <UniformGrid Columns="4">
                    <StackPanel>
                      <TextBlock Text="Status" Style="{StaticResource StatLabel}" />
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Danger}" VerticalAlignment="Center" Margin="0,3,8,0" />
                        <TextBlock Name="StatStatus" Text="Not connected" Style="{StaticResource StatValue}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Keys" Style="{StaticResource StatLabel}" />
                      <TextBlock Name="StatKeys" Text="None" Style="{StaticResource StatValue}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Things you can swap" Style="{StaticResource StatLabel}" />
                      <TextBlock Name="StatItems" Text="-" Style="{StaticResource StatValue}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Active swaps" Style="{StaticResource StatLabel}" />
                      <TextBlock Name="StatSwaps" Text="0" Style="{StaticResource StatValue}" />
                    </StackPanel>
                  </UniformGrid>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <Grid Name="ItemsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Name="CatBody" GroupName="Slots" Style="{StaticResource Pill}" Content="Cars" Tag="Body" IsChecked="True" Click="Slot_Click" />
                  <RadioButton GroupName="Slots" Style="{StaticResource Pill}" Content="Antennas" Tag="Antenna" Click="Slot_Click" />
                  <RadioButton GroupName="Slots" Style="{StaticResource Pill}" Content="Toppers" Tag="Topper" Click="Slot_Click" />
                  <RadioButton GroupName="Slots" Style="{StaticResource Pill}" Content="Wheels" Tag="Wheels" Click="Slot_Click" />
                  <RadioButton GroupName="Slots" Style="{StaticResource Pill}" Content="Boosts" Tag="Rocket Boost" Click="Slot_Click" />
                  <RadioButton GroupName="Slots" Style="{StaticResource Pill}" Content="Trails" Tag="Trail" Click="Slot_Click" />
                  <RadioButton GroupName="Slots" Style="{StaticResource Pill}" Content="Balls" Tag="Ball" Click="Slot_Click" />
                  <CheckBox Name="FavOnlyBox" Content="★ Favorites" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Right-click any item to star it" Checked="FavOnly_Changed" Unchecked="FavOnly_Changed" />
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="GridHost" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource ItemTile}" />
              </ScrollViewer>
              <TextBlock Name="EmptyText" Grid.Row="1" Text="Connect to Rocket League on the Home tab first." Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Name="CountText" Grid.Row="2" Style="{StaticResource Muted}" Margin="0,8,0,0" />
            </Grid>
            <Grid Name="FunPage" Visibility="Collapsed">
              <local:FunPanel x:Name="FunCtl" />
            </Grid>
            <Grid Name="SwapsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="SwapsHint" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="1" Content="Undo all swaps" Click="RevertAll_Click" />
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="SwapsHost" ItemTemplate="{StaticResource SwapRow}" />
              </ScrollViewer>
              <StackPanel Name="SwapsEmptyBox" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="{StaticResource LogoMark}" Width="40" Height="40" Opacity="0.18" HorizontalAlignment="Center" />
                <TextBlock Name="SwapsEmpty" Text="Nothing swapped yet. Pick an item on the Swap items tab." Style="{StaticResource Muted}" FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
            <ScrollViewer Name="ModsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,0">
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,20,0" Text="Press Swap… to put a model on the car, wheels, ball or map you pick. You can also drop a .dripRL or a 3D file (FBX, OBJ, GLB…) on this window." />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Add .dripRL…" Click="AddDripRl_Click" />
