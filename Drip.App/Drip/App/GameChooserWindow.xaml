<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Drip.App.GameChooserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fx="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore" Title="Drip Swapper" Icon="Assets/drip.ico" Width="1000" Height="560" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="CanResize" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" xmlns:app="clr-namespace:Drip.App;assembly=DripSwapper">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="GameCard" TargetType="{x:Type Border}">
        <Setter Property="MinHeight" Value="270" />
        <Setter Property="Border.CornerRadius" Value="24" />
        <Setter Property="Background" Value="{DynamicResource SlotBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SlotLine}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="{DynamicResource WindowBg}" CornerRadius="20" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#00FFFFFF" Margin="32,18,18,0" MouseLeftButtonDown="TopBar_MouseDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource LogoMark}" Width="20" Height="20" />
          <TextBlock Text="Drip Swapper" FontFamily="{StaticResource Display}" FontSize="24" Foreground="{DynamicResource TextBright}" Margin="10,0,0,2" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Name="LangBtn" Content="Language" Style="{StaticResource Quiet}" Margin="0,0,4,0" ToolTip="Change the language of Drip Swapper" Click="Language_Click" />
          <Button Content="Join our Discord" Style="{StaticResource Quiet}" Margin="0,0,4,0" ToolTip="Help, new drips and updates" Click="Discord_Click" />
          <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoContrast}" ToolTip="Switch between light and dark" Click="Theme_Click" />
          <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoClose}" Click="Close_Click" />
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,22,48,36" VerticalAlignment="Center">
          <TextBlock Text="Pick your game." FontFamily="{StaticResource Display}" FontSize="68" Foreground="{DynamicResource TextBright}" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Body}" FontSize="15" Margin="2,6,0,0" MaxWidth="560" HorizontalAlignment="Left" Text="Swaps only touch your own game files, and every one can be undone." />
          <Grid Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource GameCard}" Tag="#1F6BFF" MouseLeftButtonUp="RocketLeague_Click">
              <Grid Margin="26,24">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Width="84" Height="84" HorizontalAlignment="Left">
                  <Border Name="RlLetter" Background="#1F6BFF" CornerRadius="22">
                    <TextBlock Text="R" FontFamily="{StaticResource Display}" FontSize="46" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Image Name="RlIcon" Width="84" Height="84" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,28,0,0">
                  <TextBlock Text="Rocket League" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{DynamicResource SlotText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Cars, wheels, balls, maps, your own models, plus freeplay extras" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource SlotText2}" Margin="0,4,0,0" />
                  <TextBlock Name="RlState" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SlotText2}" Margin="0,10,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource GameCard}" Tag="#2EB8F5" MouseLeftButtonUp="Fortnite_Click">
              <Grid Margin="26,24">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Width="84" Height="84" HorizontalAlignment="Left">
                  <Border Name="FnLetter" Background="#2EB8F5" CornerRadius="22">
                    <TextBlock Text="F" FontFamily="{StaticResource Display}" FontSize="46" Foreground="#062033" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Image Name="FnIcon" Width="84" Height="84" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,28,0,0">
                  <TextBlock Text="Fortnite" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{DynamicResource SlotText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Skins, emotes, gliders, pickaxes and more. Normal Fortnite, Retrac or Stellar" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource SlotText2}" Margin="0,4,0,0" />
                  <TextBlock Name="FnState" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SlotText2}" Margin="0,10,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource GameCard}" Tag="#FF2D87" MouseLeftButtonUp="FallGuys_Click">
              <Grid Margin="26,24">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Width="84" Height="84" HorizontalAlignment="Left">
                  <Border Name="FgLetter" Background="#FF2D87" CornerRadius="22">
                    <TextBlock Text="G" FontFamily="{StaticResource Display}" FontSize="46" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Image Name="FgIcon" Width="84" Height="84" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,28,0,0">
                  <TextBlock Text="Fall Guys" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{DynamicResource SlotText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Costumes, emotes and your own bean models" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource SlotText2}" Margin="0,4,0,0" />
                  <TextBlock Name="FgState" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SlotText2}" Margin="0,10,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid Name="FnPicker" RowSpan="2" Visibility="Collapsed" Background="#99000000" MouseLeftButtonDown="FnPickerBackdrop_Down">
        <Border Name="FnPickerCard" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="24" Padding="30,26" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1000">
          <StackPanel>
            <Grid>
              <TextBlock Text="Which Fortnite?" FontFamily="{StaticResource Display}" FontSize="40" Foreground="{DynamicResource TextBright}" />
              <Button Style="{StaticResource WinBtn}" Content="{StaticResource IcoClose}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="FnPickerClose_Click" />
            </Grid>
            <TextBlock Style="{StaticResource Body}" FontSize="14" Margin="2,2,0,0" Text="Pick where you play." />
            <Grid Margin="0,22,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource GameCard}" MinWidth="270" Tag="#2EB8F5" MouseLeftButtonUp="FnNormal_Click">
                <Grid Margin="26,24">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Width="84" Height="84" HorizontalAlignment="Left">
                    <Border Name="PkFnLetter" Background="#2EB8F5" CornerRadius="22">
                      <TextBlock Text="F" FontFamily="{StaticResource Display}" FontSize="46" Foreground="#062033" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Name="PkFnIcon" Width="84" Height="84" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                  <StackPanel Grid.Row="2" Margin="0,28,0,0">
                    <TextBlock Text="Fortnite" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{DynamicResource SlotText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="The Epic launcher version" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource SlotText2}" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource GameCard}" MinWidth="270" Tag="#FFD11A" MouseLeftButtonUp="FnRetrac_Click">
                <Grid Margin="26,24">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Width="84" Height="84" HorizontalAlignment="Left">
                    <Border Name="PkRtLetter" Background="#FFD11A" CornerRadius="22">
                      <TextBlock Text="R" FontFamily="{StaticResource Display}" FontSize="46" Foreground="#241B00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Name="PkRtIcon" Width="84" Height="84" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                  <StackPanel Grid.Row="2" Margin="0,28,0,0">
                    <TextBlock Text="Retrac" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{DynamicResource SlotText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="The OG server, every skin and emote" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource SlotText2}" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource GameCard}" MinWidth="270" Tag="#8A7BFF" MouseLeftButtonUp="FnStellar_Click">
                <Grid Margin="26,24">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Width="84" Height="84" HorizontalAlignment="Left">
                    <Border Name="PkStLetter" Background="#8A7BFF" CornerRadius="22">
                      <TextBlock Text="S" FontFamily="{StaticResource Display}" FontSize="46" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Name="PkStIcon" Width="84" Height="84" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                  <StackPanel Grid.Row="2" Margin="0,28,0,0">
                    <TextBlock Text="Stellar" FontFamily="{StaticResource Display}" FontSize="32" Foreground="{DynamicResource SlotText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Project Stellar, Chapter 2 Season 2 and older" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource SlotText2}" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>